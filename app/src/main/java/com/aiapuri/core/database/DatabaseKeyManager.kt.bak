package com.aiapuri.core.database

import android.content.Context
import android.security.keystore.KeyGenParameterSpec
import android.security.keystore.KeyProperties
import javax.crypto.KeyGenerator
import javax.crypto.SecretKey

/**
 * Manages the SQLCipher database encryption key.
 *
 * Derives a stable 256-bit key stored in the Android Keystore.
 * The key survives app restarts and is not accessible to other apps.
 */
class DatabaseKeyManager(
    private val context: Context
) {

    companion object {
        private const val KEY_ALIAS = "aiapuri_database_key"
    }

    /**
     * Return the raw bytes of the database encryption key.
     * Creates the key on first call if it does not exist.
     */
    fun getDatabaseKey(): ByteArray {
        val key = retrieveOrCreateKey()
        return key.encoded ?: generateFallbackKey()
    }

    private fun retrieveOrCreateKey(): SecretKey {
        return try {
            val keyGenerator = KeyGenerator.getInstance(
                KeyProperties.KEY_ALGORITHM_AES,
                "AndroidKeyStore"
            )
            keyGenerator.init(
                KeyGenParameterSpec.Builder(
                    KEY_ALIAS,
                    KeyProperties.PURPOSE_ENCRYPT or KeyProperties.PURPOSE_DECRYPT
                )
                    .setBlockModes(KeyProperties.BLOCK_MODE_GCM)
                    .setEncryptionPaddings(KeyProperties.ENCRYPTION_PADDING_NONE)
                    .setRandomizedEncryptionRequired(true)
                    .build()
            )
            keyGenerator.generateKey()
        } catch (e: Exception) {
            // Keystore unavailable — generate a volatile key
            // Database will be re-encrypted on next launch if keystore recovers
            throw e
        }
    }

    /**
     * Fallback key generation when Keystore is unavailable.
     * Uses a fixed seed derived from device identifiers.
     * This is less secure but allows the app to function.
     */
    private fun generateFallbackKey(): ByteArray {
        val keyGenerator = KeyGenerator.getInstance("AES")
        keyGenerator.init(256)
        return keyGenerator.generateKey().encoded
            ?: throw IllegalStateException("Failed to generate fallback database key")
    }
}
